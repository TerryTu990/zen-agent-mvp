{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zen-agent.dev/schema/tool-definition/v1.json",
  "title": "zen-agent 工具定义契约 C1（tool-definition，SSOT）",
  "description": "单个工具的权威定义——agent 可调用能力的唯一登记形态，配置快照内 assets/features/<id>/tools.json 的数组元素即本契约实例。【riskTier 即操作分级矩阵落点】auto=直接执行 / hitl=挂起等人裁决 / forbidden=声明存在但永拒；判定永远在服务端工具执行层 fail-closed（U7），客户端零治理判定。【execution 双通道闭集】client=签名一次性指令下发、插件在页面环境以用户会话代执行；server=服务端直调（枚举保留、MVP 不实现，U3——枚举值不删，升级只补执行器不动契约）。adapter 按 execution 分形（if/then 强制）：client 用请求模板、server 用 API 映射。【结果回喂】exec-result 回传 body 经 resultSchema 服务端校验通过后才规整为 observation 回喂 agent（U7）。本定义整体 JSON 可序列化，跨端口传递满足 U1。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "featureIds", "description", "params", "execution", "riskTier", "adapter", "resultSchema"],
  "properties": {
    "id": {
      "$comment": "工具全局唯一标识（kebab，可点号分段命名空间）。审计事件、tool-card、门禁决策均以此关联。",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "featureIds": {
      "$comment": "本工具挂载的功能闭单（装配白名单来源：装配器按当前 featureId 过滤出可见工具集，每轮换出）。",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/featureId" }
    },
    "description": {
      "$comment": "面向 LLM 的工具说明（何时用/做什么/参数含义），直接进 tool spec；写给模型而非写给人。",
      "type": "string",
      "minLength": 1
    },
    "params": {
      "$comment": "入参契约：内联 JSON Schema（draft 2020-12）对象，装配期原样进 LLM tool spec，执行前服务端按此校验实参。",
      "type": "object"
    },
    "execution": {
      "$comment": "执行通道闭集（U3）：MVP 只实现 client，server 保留不删。agent 对通道无感知（D3），通道是定义侧配置维度。",
      "type": "string",
      "enum": ["client", "server"]
    },
    "riskTier": {
      "$comment": "操作分级闭集：auto 直执 / hitl 人审 / forbidden 永拒。服务端唯一决策点按此判定，缺失或未知值一律 deny（fail-closed，U7）。",
      "type": "string",
      "enum": ["auto", "hitl", "forbidden"]
    },
    "hitlMode": {
      "$comment": "HITL 授权粒度（仅 riskTier=hitl 有意义，缺省 per-task）：per-task 同任务首批确认后自动放行；every-call 对外不可撤回动作，toolgate 跳过任务级授权复用、次次挂起单独确认（不复用授权）。",
      "type": "string",
      "enum": ["per-task", "every-call"]
    },
    "authorization": {
      "$comment": "ADR-016 服务端有界自动履约授权；只声明 opaque intentId 的参数名，不承载业务键、策略或客户端判定。",
      "$ref": "#/$defs/boundedFulfillmentAuthorization"
    },
    "adapter": {
      "$comment": "执行适配段，形状由 execution 决定（见根级 if/then 分形）。",
      "type": "object"
    },
    "resultSchema": {
      "$comment": "执行结果契约：内联 JSON Schema（draft 2020-12）对象。exec-result.body 服务端校验不过 = invalid-result，不回喂 agent（U7）。",
      "type": "object"
    }
  },
  "if": {
    "properties": { "execution": { "const": "client" } },
    "required": ["execution"]
  },
  "then": {
    "properties": {
      "adapter": {
        "$comment": "client 通道下按 kind 分形：缺省 = HTTP 请求模板；kind='dom' = 可见页面代操作（adr-011）。",
        "oneOf": [{ "$ref": "#/$defs/clientAdapter" }, { "$ref": "#/$defs/domAdapter" }]
      }
    }
  },
  "else": {
    "properties": { "adapter": { "$ref": "#/$defs/serverAdapter" } }
  },
  "$defs": {
    "boundedFulfillmentAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workflow", "intentIdParam"],
      "properties": {
        "kind": { "const": "bounded-fulfillment" },
        "workflow": { "enum": ["shipment", "delivery"] },
        "intentIdParam": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
        "preparation": { "$ref": "#/$defs/intentPreparation" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "workflow": { "const": "delivery" }, "preparation": true },
            "required": ["workflow", "preparation"]
          },
          "then": {
            "properties": {
              "preparation": {
                "type": "object",
                "properties": {
                  "elements": {
                    "type": "object",
                    "properties": { "messageRef": true, "sendRef": true },
                    "required": ["messageRef", "sendRef"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "workflow": { "const": "shipment" }, "preparation": true },
            "required": ["workflow", "preparation"]
          },
          "then": {
            "properties": {
              "preparation": {
                "type": "object",
                "properties": {
                  "elements": {
                    "type": "object",
                    "properties": { "actionRef": true },
                    "required": ["actionRef"]
                  },
                  "evidence": {
                    "type": "object",
                    "properties": { "rule": true, "before": true, "after": true },
                    "required": ["rule", "before", "after"]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "intentPreparation": {
      "$comment": "adr-019 声明式 intent 准备（原语闭集 v1）：有此声明的 bounded-fulfillment 工具由网关注入零参数配套 prepare 工具（名=prepare.<toolId>），服务端引擎按声明从可信 URL/快照派生业务输入，模型零参数（adr-016 不可扩张面）。任何字段缺失/证据不唯一/不匹配即拒绝准备（fail-closed）；声明外形态一律拒绝，本闭集扩展走契约版本。",
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "routes", "params", "productParam", "elements", "evidence", "intentTtlMs"],
      "properties": {
        "description": {
          "$comment": "配套 prepare 工具面向 LLM 的说明（站点语义文案随 pack 走，不进核心代码）。",
          "type": "string",
          "minLength": 1
        },
        "routes": {
          "$comment": "激活页 hash 路由白名单（origin 恒取 pack.site.origin，不在此声明）。",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^/" }
        },
        "params": {
          "$comment": "业务参数派生源：只取可信 URL/快照，禁模型注入。",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$defs/hashQueryParamSource" },
              { "$ref": "#/$defs/elementHrefParamSource" }
            ]
          }
        },
        "productParam": {
          "$comment": "经服务端 productKeys 闭集映射为库存 productKey 的参数名；必须是 params 的键（载入期校验）。",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "elements": {
          "$comment": "DOM ref 绑定：按 role[+label] 在快照内唯一命中，不唯一即拒绝。键名按 workflow 约束（delivery: messageRef+sendRef；shipment: actionRef）。",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role"],
            "properties": {
              "role": { "type": "string", "minLength": 1, "maxLength": 32 },
              "label": { "type": "string", "minLength": 1, "maxLength": 64 },
              "requireEnabled": { "const": true }
            }
          }
        },
        "paramEvidence": {
          "$comment": "参数-页面一致性证据：指定参数值必须在指定 role 的元素 label 中唯一回显（label 去空白后 = 值，或 = 前缀[+可选冒号分隔]+值）。",
          "type": "object",
          "additionalProperties": false,
          "required": ["param", "roles"],
          "properties": {
            "param": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
            "roles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 32 }
            },
            "labelPrefixes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 32 }
            }
          }
        },
        "evidence": {
          "$comment": "结构化证据绑定：rule 必须引用同工具 adapter.snapshotEvidence 的 id（载入期校验）。delivery 只填 rule（基线计数语义）；shipment 另需 before/after（状态跃迁语义，均须 ∈ rule.statuses）。",
          "type": "object",
          "additionalProperties": false,
          "required": ["rule"],
          "properties": {
            "rule": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
            "before": { "type": "string", "minLength": 1, "maxLength": 32 },
            "after": { "type": "string", "minLength": 1, "maxLength": 32 }
          }
        },
        "intentTtlMs": {
          "$comment": "intent 绝对有效期（准备时刻起算毫秒）。",
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000
        }
      }
    },
    "hashQueryParamSource": {
      "$comment": "从激活页 URL 的 hash query 段取参：#/route?name=value。取值 trim 后须非空且通过可选 pattern。",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "name"],
      "properties": {
        "source": { "const": "hash-query" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "elementHrefParamSource": {
      "$comment": "从快照元素 href 取参：href 须精确匹配 urlOrigin+urlPath、恰含 queryParam 一个查询参数、无 hash 无凭证；命中元素须唯一。",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "urlOrigin", "urlPath", "queryParam"],
      "properties": {
        "source": { "const": "element-href" },
        "urlOrigin": { "type": "string", "pattern": "^https?://[^/]+$" },
        "urlPath": { "type": "string", "pattern": "^/" },
        "queryParam": { "type": "string", "minLength": 1, "maxLength": 64 },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "featureId": {
      "$comment": "功能标识文法，与 config-snapshot manifest.featureIdRules[].featureId 同文法（跨契约对齐）。",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "httpMethod": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
    },
    "templateString": {
      "$comment": "模板串：{{paramName}} 占位符按名绑定 params 属性，服务端签发 exec-instruction 前完成实参代入——客户端只收已定值的最终请求，不做模板求值（客户端零治理判定）。",
      "type": "string",
      "minLength": 1
    },
    "clientAdapter": {
      "$comment": "client 通道适配：宿主 API 请求模板。服务端代入实参后签名下发（nonce+ttl 一次性，U7），插件在页面环境以用户既有会话（cookie 等）发出——构造上即用户权限、无提权面（D2）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "urlTemplate"],
      "properties": {
        "method": { "$ref": "#/$defs/httpMethod" },
        "urlTemplate": {
          "$comment": "宿主 API 地址模板：同源相对路径（/api/...）或绝对 URL，可含 {{param}} 占位符。",
          "$ref": "#/$defs/templateString"
        },
        "headers": {
          "$comment": "附加请求头（值可含占位符）。凭证真值禁入（身份走用户会话透传，平台零特权）。",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/templateString" }
        },
        "bodyTemplate": {
          "$comment": "请求体模板：JSON 对象（叶子字符串可含占位符）或整体字符串模板；GET/DELETE 通常省略。",
          "anyOf": [{ "type": "object" }, { "type": "string" }]
        }
      }
    },
    "domAdapter": {
      "$comment": "dom 通道适配（adr-011 可见页面代操作）：无请求模板——步骤由 agent 按页面快照临场决策，服务端逐批 fail-closed 校验（动作闭集/ref 出自最近快照/围栏）后一次性签名下发；工具 params 应声明 steps+summary 的入参契约。",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pathPrefixes"],
      "properties": {
        "kind": { "const": "dom" },
        "pathPrefixes": {
          "$comment": "URL 路径前缀围栏：快照页路径不在围栏内即 deny，操作面不越出功能页面范围。",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^/" }
        },
        "snapshotEvidence": {
          "$comment": "pack 级只读结构化证据配方：客户端按 itemSelector 唯一容器计数，只从容器内 statusSelector 的叶节点读取 statuses 闭集值；不返回消息正文。",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "itemSelector", "statusSelector", "statuses"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
              "itemSelector": { "type": "string", "minLength": 1, "maxLength": 200 },
              "statusSelector": { "type": "string", "minLength": 1, "maxLength": 200 },
              "statuses": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 32 }
              }
            }
          }
        }
      }
    },
    "serverAdapter": {
      "$comment": "server 通道适配：服务端直调 API 映射（token 化 API 首选）。U3 保留段——MVP 定形不实现，标准版补执行器时本契约不变。凭证一律 credentialRef 引用名，真值由服务端运行时注入、永不入配置。",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "urlTemplate"],
      "properties": {
        "method": { "$ref": "#/$defs/httpMethod" },
        "urlTemplate": {
          "$comment": "目标 API 绝对 URL 模板，可含 {{param}} 占位符。",
          "$ref": "#/$defs/templateString"
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/templateString" }
        },
        "bodyTemplate": {
          "anyOf": [{ "type": "object" }, { "type": "string" }]
        },
        "credentialRef": {
          "$comment": "服务端托管凭证的引用名（非值）；解析仅发生在执行器边界，不进 Context/审计。",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        }
      }
    }
  }
}
